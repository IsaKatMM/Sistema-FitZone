@startuml C4_Container_Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Diagrama C4 - Nivel 2 (Container) - Sistema Fitness

Person(user, "Usuario", "Usuario del sistema fitness")

System_Boundary(fitness, "Sistema Fitness") {
    Container(mobile, "Aplicación Móvil", "React Native/Expo", "App móvil para iOS y Android")
    Container(api, "API REST", "Spring Boot", "Backend que expone servicios REST")
    ContainerDb(db, "Base de Datos", "PostgreSQL", "Almacena usuarios, rutinas, ejercicios, etc.")
    Container(auth, "Servicio Auth", "Spring Security + JWT", "Autenticación y autorización")
}

Rel(user, mobile, "Usa", "HTTPS")
Rel(mobile, api, "Hace peticiones a", "JSON/HTTPS")
Rel(api, db, "Lee/Escribe", "JDBC")
Rel(api, auth, "Valida con")
Rel(mobile, mobile, "Almacena token en", "Expo SecureStore")

@enduml